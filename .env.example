# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Snowflake ────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_SCHEMA=PUBLIC                 # optional, defaults to PUBLIC

# ── App ──────────────────────────────────────────────
APP_PASSWORD=your_app_password          # legacy password gate; ignored when DATABASE_URL is set

# ── JWT authentication (set DATABASE_URL to enable JWT mode) ─────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string   # openssl rand -hex 32
JWT_EXPIRE_HOURS=8                      # token lifetime in hours
ADMIN_USERNAME=admin                    # auto-created admin on first startup
ADMIN_PASSWORD=change-me-strong-password

# ── PostgreSQL (enables JWT auth + persistent audit log) ─────────────────────
# On Railway: add a PostgreSQL service and this is set automatically.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Redis (enables cross-worker rate limiting + result cache) ─────────────────
# On Railway: add a Redis service and this is set automatically.
REDIS_URL=redis://localhost:6379

# ── Performance (optional — defaults shown) ──────────
SNOWFLAKE_POOL_SIZE=5                   # persistent connections in the pool
SNOWFLAKE_ACQUIRE_TIMEOUT=30            # seconds to wait for a pool connection
QUERY_TIMEOUT_SECONDS=120               # Snowflake network/query timeout
RESULT_CACHE_TTL=300                    # seconds to cache identical SQL results
RESULT_CACHE_MAX=200                    # max cached entries (evicts oldest)
RATE_LIMIT_RPM=20                       # max requests per minute per IP

# ── Governance (optional) ────────────────────────────
AUDIT_DB_PATH=/tmp/audit.db             # SQLite fallback audit log path
CB_FAILURE_THRESHOLD=5                  # consecutive failures before circuit opens
CB_RECOVERY_TIMEOUT=60                  # seconds before circuit tries recovery

# ── Metrics ──────────────────────────────────────────
METRICS_ENABLED=true                    # expose /metrics endpoint (Prometheus)

# ── Secrets (enterprise — optional) ──────────────────
# AWS Secrets Manager: store all secrets as a JSON object in one secret.
AWS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:my-secret

# HashiCorp Vault KV-v2: store secrets at the path below.
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=s.xxxxxxxxxxxxxxxxxxxxxxxx
VAULT_PATH=secret/data/snowflake-agent  # optional, this is the default
