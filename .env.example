# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Snowflake ────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_SCHEMA=PUBLIC                 # optional, defaults to PUBLIC

# ── App ──────────────────────────────────────────────
APP_PASSWORD=your_app_password          # gates the web UI; leave blank to disable

# ── Performance (optional — defaults shown) ──────────
SNOWFLAKE_POOL_SIZE=5                   # persistent connections in the pool
SNOWFLAKE_ACQUIRE_TIMEOUT=30            # seconds to wait for a pool connection
QUERY_TIMEOUT_SECONDS=120               # Snowflake network/query timeout
RESULT_CACHE_TTL=300                    # seconds to cache identical SQL results
RESULT_CACHE_MAX=200                    # max cached entries (evicts oldest)
RATE_LIMIT_RPM=20                       # max requests per minute per IP

# ── Governance (optional) ────────────────────────────
AUDIT_DB_PATH=/tmp/audit.db             # SQLite file for audit log
CB_FAILURE_THRESHOLD=5                  # consecutive failures before circuit opens
CB_RECOVERY_TIMEOUT=60                  # seconds before circuit tries recovery
